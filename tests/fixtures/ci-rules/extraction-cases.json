{
  "version": 1,
  "about": "Cases of deployment files in and findings out, held by the GitHub Action's and the CLI's suites alike. A runner writes each case's files (text as UTF-8, or base64 as bytes) to an empty directory, scans them in the order listed, and evaluates the settings against the lock-free rule set of evaluation-cases.json; it must give exactly the case's findings, in order, and its problems. The two copies are byte-identical: each suite pins this file's SHA-256.",
  "cases": [
    {
      "name": "a block mapping indented between two levels is not valid YAML",
      "files": [
        {
          "path": "deploy/a.yaml",
          "text": "logging:\n  level:\n    root: INFO\n   com.acme: TRACE\n"
        }
      ],
      "findings": [],
      "problems": [
        {
          "path": "deploy/a.yaml",
          "line": 1,
          "reason": "not valid YAML"
        }
      ]
    },
