    {
      "name": "any name ending -extension.jar is taken as a bundle's",
      "settings": [
        {
          "name": "OTEL_JAVAAGENT_EXTENSIONS",
          "value": "/opt/vendor-extension.jar",
          "path": "compose.yaml",
          "line": 9
